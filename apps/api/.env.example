# API runtime configuration.
NODE_ENV=development
PORT=3000

# PostgreSQL connection. Keep credentials in a local secret manager outside development.
DATABASE_URL=postgresql://library:library@localhost:5432/library?schema=public

# Browser origin allowed by CORS.
FRONTEND_URL=http://localhost:5173
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/auth/google/callback

#GOOGLE OAUTH
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
OAUTH_AUTHORIZATION_TTL_SECONDS=300

#GOOGLE BOOKS API
GOOGLE_BOOKS_API_KEY=replace-with-google-books-api-key

# Gemini API
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_RECOMMENDATION_MODEL=gemini-3.8-flash
