generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OAuthProvider {
  GOOGLE
}

enum ReadingState {
  WANT_TO_READ
  READING
  READ
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String?
  name           String?
  avatarUrl      String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  oauthAccounts  OAuthAccount[]
  sessions       Session[]
  libraryEntries LibraryEntry[]
  readingGoals   ReadingGoal[]

  @@map("users")
}

model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  user              User          @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model OAuthAuthorization {
  id           String        @id @default(uuid())
  provider     OAuthProvider
  stateHash    String        @unique @map("state_hash")
  codeVerifier String        @map("code_verifier")
  expiresAt    DateTime      @map("expires_at")
  consumedAt   DateTime?     @map("consumed_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_authorizations")
}

model Book {
  id             String         @id @default(uuid())
  googleBooksId  String         @unique
  title          String
  authors        String[]
  description    String?
  coverUrl       String?        @map("cover_url")
  language       String?
  pageCount      Int?           @map("page_count")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  libraryEntries LibraryEntry[]

  @@map("books")
}

model LibraryEntry {
  id          String       @id @default(uuid())
  user        User         @relation(fields: [userId], references: [id])
  book        Book         @relation(fields: [bookId], references: [id])
  status      ReadingState
  currentPage Int?         @default(0) @map("current_page")
  rating      Int?
  review      String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  bookId      String
  userId      String
  notes       Note[]

  @@unique([bookId, userId])
  @@index([userId, status, updatedAt])
  @@map("library_entries")
}

model Note {
  id             String       @id @default(uuid())
  libraryEntry   LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  libraryEntryId String

  @@map("notes")
}

model ReadingGoal {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  year        Int
  targetBooks Int      @map("target_books")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, year])
  @@index([userId, year])
  @@map("reading_goals")
}
