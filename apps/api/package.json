{
  "name": "@library/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/server.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --project tsconfig.json",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --exclude \"src/**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "test:watch": "vitest watch --exclude \"src/**/*.integration.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@library/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
