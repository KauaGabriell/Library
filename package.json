{
  "name": "library",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive --if-present run dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm --filter @library/api test:unit && pnpm --filter @library/contracts test:unit",
    "test:integration": "pnpm --filter @library/api test:integration",
    "test:all": "pnpm run test:unit && pnpm run test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "typescript": "^7.0.2"
  }
}
